\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The BENEFITS reference architecture. Participant devices (web and mobile) sync a consent-filtered PouchDB outbox into a private CouchDB whose \texttt  {validate\_doc\_update} function enforces the device-side gate (S1). The community connector aggregates per-participant databases, runs the privacy pipeline, and releases through an EDC connector under ODRL constraints, steward co-signatures, and the audit chain (S2). Shared conformance vectors pin identical verdicts across the TypeScript and Java implementations.}}{10}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:architecture}{{1}{10}{The BENEFITS reference architecture. Participant devices (web and mobile) sync a consent-filtered PouchDB outbox into a private CouchDB whose \texttt {validate\_doc\_update} function enforces the device-side gate (S1). The community connector aggregates per-participant databases, runs the privacy pipeline, and releases through an EDC connector under ODRL constraints, steward co-signatures, and the audit chain (S2). Shared conformance vectors pin identical verdicts across the TypeScript and Java implementations}{figure.caption.1}{}}
\newlabel{fig:architecture@cref}{{[figure][1][]1}{[1][9][]10}}
