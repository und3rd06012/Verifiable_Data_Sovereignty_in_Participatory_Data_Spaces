\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Paying for the Two-Language Boundary}{11}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The two enforcement points of the consent model. One rule set is compiled twice: into the CouchDB \texttt  {validate\_doc\_update} function (S1, TypeScript) and into the ODRL constraint functions evaluated by the EDC policy engine (S2, Java). The conformance vectors run against both suites and require byte-identical verdicts. Any disagreement is a defect in the departing implementation.}}{12}{figure.caption.2}\protected@file@percent }
\newlabel{fig:enforcement-points}{{2}{12}{The two enforcement points of the consent model. One rule set is compiled twice: into the CouchDB \texttt {validate\_doc\_update} function (S1, TypeScript) and into the ODRL constraint functions evaluated by the EDC policy engine (S2, Java). The conformance vectors run against both suites and require byte-identical verdicts. Any disagreement is a defect in the departing implementation}{figure.caption.2}{}}
\newlabel{fig:enforcement-points@cref}{{[figure][2][]2}{[1][11][]12}}
