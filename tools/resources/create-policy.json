{
  "@context": { "@vocab": "https://w3id.org/edc/v0.0.1/ns/" },
  "@id": "probe-policy",
  "policy": {
    "@context": [
      "http://www.w3.org/ns/odrl.jsonld",
      { "benefits": "https://w3id.org/benefits/v1/ns/" }
    ],
    "@type": "Set",
    "permission": [
      {
        "action": "use",
        "constraint": {
          "@type": "AtomicConstraint",
          "leftOperand": "benefits:probe",
          "operator": "eq",
          "rightOperand": "on"
        }
      }
    ],
    "prohibition": [],
    "obligation": []
  }
}
